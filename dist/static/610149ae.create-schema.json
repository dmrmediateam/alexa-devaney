              },
              {
                "readOnly": true,
                "name": "googleAdsCampaignId",
                "type": "string",
                "title": "Google Ads campaign ID"
              }
            ],
            "type": "object",
            "name": "campaign"
          }
        ],
        "name": "campaigns",
        "type": "array"
      },
      {
