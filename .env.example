# Copy to .env.local and fill in. .env.local is gitignored: never commit real keys.
# The same names go in Vercel: Settings -> Environment Variables (then redeploy).

# ---- Leads (without these, submissions are only logged, never delivered) ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
LEAD_NOTIFY_EMAIL=
# LEAD_AUTORESPONDER=on          # instant confirmation email to the lead
# LEAD_WEBHOOK_URL=              # CRM push (Follow Up Boss)

# ---- Lead texts (optional, needs Twilio) ----
# LEAD_NOTIFY_SMS=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---- IDX Broker (turns on live MLS search) ----
IDX_API_KEY=
IDX_ANCILLARY_KEY=
IDX_MARKET_CITIES=Encinitas,Carlsbad,Oceanside,Vista,Fallbrook
IDX_OFFICE_IDS=

# ---- Address autocomplete on /home-value (Places API (New) enabled) ----
GOOGLE_MAPS_API_KEY=

# ---- Analytics (not secret; prefer content/site.ts analytics block) ----
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=

# ---- DMR client dashboard (Sanity Studio + /client-portal) ----
# SANITY_API_TOKEN is the one dashboard secret (sanity.io/manage -> API -> Tokens -> Editor).
SANITY_API_TOKEN=
NEXT_PUBLIC_SANITY_PROJECT_ID=yy80nmbb
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_SANITY_STUDIO_URL=https://alexa-devaney.sanity.studio/dashboard
# DMR_TEAM_EMAIL=team@dmrmedia.org      # who gets "Adjust ad spend" emails
# DMR_STUDIO_ORIGINS=                   # extra Studio origins, comma-separated
# Studio only (set before `npm run sanity:deploy`):
SANITY_STUDIO_SITE_URL=https://www.alexadevaney.com

# ---- Google Ads sync -> dashboard (/api/dmr/sync-google-ads, daily cron) ----
# DMR-wide credentials, the same for every client. The client's own customer
# id goes in the Studio (Report Settings -> Data source), not here.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9224492796
# GOOGLE_ADS_API_VERSION=v25
# Protects the cron routes (openssl rand -hex 32). Vercel Cron sends it automatically.
CRON_SECRET=
