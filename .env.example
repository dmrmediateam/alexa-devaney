# Copy to .env.local and fill in. .env.local is gitignored: never commit real keys.
# The same names go in Vercel: Settings -> Environment Variables (then redeploy).

# ---- Leads (without these, submissions are only logged, never delivered) ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
LEAD_NOTIFY_EMAIL=
# LEAD_AUTORESPONDER=on          # instant confirmation email to the lead
# LEAD_WEBHOOK_URL=              # CRM push (Follow Up Boss)

# ---- Lead texts (optional, needs Twilio) ----
# LEAD_NOTIFY_SMS=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---- IDX Broker (turns on live MLS search) ----
IDX_API_KEY=
IDX_ANCILLARY_KEY=
IDX_MARKET_CITIES=Encinitas,Carlsbad,Oceanside,Vista,Fallbrook
IDX_OFFICE_IDS=

# ---- Address autocomplete on /home-value (Places API (New) enabled) ----
GOOGLE_MAPS_API_KEY=

# ---- Analytics (not secret; prefer content/site.ts analytics block) ----
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=
